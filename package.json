{
  "name": "dsh-eval-control",
  "version": "0.2.8",
  "description": "DSH plugin for aeval evaluation control and realtime, projection-based personal trajectory analytics.",
  "license": "Apache-2.0",
  "keywords": [
    "aeval",
    "dsh",
    "deepseek-harness",
    "cordis",
    "dsh-plugin",
    "agent-evaluation",
    "gateway-lease",
    "eval-harness"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xyrrrrr-r/dsh-eval-control.git"
  },
  "homepage": "https://github.com/xyrrrrr-r/dsh-eval-control#readme",
  "bugs": {
    "url": "https://github.com/xyrrrrr-r/dsh-eval-control/issues"
  },
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "icon": "./icon.svg",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": "./client/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./dist/*": "./dist/*",
    "./src/*": "./src/*"
  },
  "bin": {
    "aeval-dsh-session-reader": "dist/session_reader.js",
    "aeval-dsh-session-stub": "dist/session_stub.js",
    "aeval-model-broker": "dist/broker_main.js",
    "aeval-dsh-control-selfcheck": "dist/selfcheck.js"
  },
  "files": [
    "dist",
    "src",
    "client",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "pull-neutral": "node scripts/pull-neutral.mjs",
    "sync:trajectory-fixtures": "node scripts/sync-trajectory-fixtures.mjs",
    "vendor:neutral": "node scripts/pull-neutral.mjs --refresh-vendor",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.client.json",
    "typecheck:host": "tsc --noEmit",
    "typecheck:client": "tsc -p tsconfig.client.json",
    "build": "npm run pull-neutral && tsc -p tsconfig.build.json && npm run bundle:standalone && npm run build:client",
    "build:client": "node scripts/build-client.mjs",
    "bundle:standalone": "node scripts/bundle-standalone.mjs",
    "prepublishOnly": "npm run build && npm test",
    "clean:test": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('.test-dist', { recursive: true, force: true })\"",
    "test": "npm run build && npm run clean:test && tsc -p tsconfig.test.json && npm run pull-neutral && npm run bundle:standalone && node scripts/run-tests.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session"
      ]
    }
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.4.0",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh": ">=0.1.7-alpha.1 <0.1.8-0 || >=0.1.8-alpha.1 <0.2.0-0 || >=0.2.0-0 <0.3.0-0",
    "@deepseek-ai/dsh-acp": ">=0.1.7-alpha.1 <0.1.8-0 || >=0.1.8-alpha.1 <0.2.0-0 || >=0.2.0-0 <0.3.0-0",
    "@deepseek-ai/dsh-agent": ">=0.1.7-alpha.1 <0.1.8-0 || >=0.1.8-alpha.1 <0.2.0-0 || >=0.2.0-0 <0.3.0-0",
    "@deepseek-ai/dsh-compaction": "0.2.0-rc.2",
    "@deepseek-ai/dsh-experimental-agent-team": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": ">=0.1.7-alpha.1 <0.1.8-0 || >=0.1.8-alpha.1 <0.2.0-0 || >=0.2.0-0 <0.3.0-0",
    "@deepseek-ai/dsh-llm-retry": "0.2.0-rc.2",
    "@deepseek-ai/dsh-scope": ">=0.1.7-alpha.1 <0.1.8-0 || >=0.1.8-alpha.1 <0.2.0-0 || >=0.2.0-0 <0.3.0-0",
    "@deepseek-ai/dsh-sdk-protocol": ">=0.1.7-alpha.1 <0.1.8-0 || >=0.1.8-alpha.1 <0.2.0-0 || >=0.2.0-0 <0.3.0-0",
    "@deepseek-ai/dsh-session": ">=0.1.7-alpha.1 <0.1.8-0 || >=0.1.8-alpha.1 <0.2.0-0 || >=0.2.0-0 <0.3.0-0",
    "@deepseek-ai/dsh-session-persistence": ">=0.1.7-alpha.1 <0.1.8-0 || >=0.1.8-alpha.1 <0.2.0-0 || >=0.2.0-0 <0.3.0-0",
    "@deepseek-ai/dsh-session-persistence-jsonl": ">=0.1.7-alpha.1 <0.1.8-0 || >=0.1.8-alpha.1 <0.2.0-0 || >=0.2.0-0 <0.3.0-0",
    "@deepseek-ai/dsh-session-projection": "0.2.0-rc.2",
    "@deepseek-ai/dsh-system-prompt": ">=0.1.7-alpha.1 <0.1.8-0 || >=0.1.8-alpha.1 <0.2.0-0 || >=0.2.0-0 <0.3.0-0",
    "@deepseek-ai/dsh-tools": ">=0.1.7-alpha.1 <0.1.8-0 || >=0.1.8-alpha.1 <0.2.0-0 || >=0.2.0-0 <0.3.0-0",
    "@deepseek-ai/schemastery": "^3.18.4",
    "@deepseek-ai/dsh-config-editor": ">=0.2.0-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-typert-protocol": ">=0.2.0-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-host-webserver": ">=0.2.0-rc.2 <0.3.0-0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh": "0.2.0-rc.2",
    "@deepseek-ai/dsh-acp": "0.2.0-rc.2",
    "@deepseek-ai/dsh-agent": "0.2.0-rc.2",
    "@deepseek-ai/dsh-compaction": "0.2.0-rc.2",
    "@deepseek-ai/dsh-experimental-agent-team": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm-retry": "0.2.0-rc.2",
    "@deepseek-ai/dsh-ptc-runtime": "0.2.0-rc.2",
    "@deepseek-ai/dsh-scope": "0.2.0-rc.2",
    "@deepseek-ai/dsh-sdk-protocol": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session-persistence": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session-projection": "0.2.0-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "3.18.4",
    "@types/node": "24.13.6",
    "esbuild": "0.28.2",
    "typescript": "6.0.3",
    "@deepseek-ai/dsh-config-editor": "0.2.0-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.2.0-rc.2",
    "@deepseek-ai/dsh-host-webserver": "0.2.0-rc.2"
  }
}
